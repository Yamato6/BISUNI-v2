# Copia este archivo a .env y pon valores reales. .env NO se versiona.

# --- Base de datos (docker-compose, desktop y web) ---
DB_NAME=bisuni
DB_USER=bisuni
DB_PASSWORD=cambia-esta-contraseña
DB_HOST=localhost
# Si ya tienes un PostgreSQL nativo en 5432, usa otro puerto (p. ej. 5433) para la BD de
# desarrollo embebida (desktop: mvnw exec:java) y ajusta también DATABASE_URL.
DB_PORT=5432

# URL completa que usa web/ (Drizzle / driver postgres)
DATABASE_URL=postgres://bisuni:cambia-esta-contraseña@localhost:5432/bisuni

# --- web/ (Auth.js) ---
# Genera uno con: npx auth secret
AUTH_SECRET=
