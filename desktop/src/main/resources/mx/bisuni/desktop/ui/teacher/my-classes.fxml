<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.teacher.MyClassesController"
      styleClass="view" spacing="14">
    <VBox spacing="2">
        <Label fx:id="titleLabel" text="Mis clases" styleClass="view-title"/>
        <Label text="Las materias que impartes en cada grupo. Doble clic en una clase para capturar sus calificaciones."
               styleClass="view-subtitle" wrapText="true"/>
    </VBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="groupCol" text="Grupo" prefWidth="90"/>
            <TableColumn fx:id="subjectCol" text="Materia" prefWidth="240"/>
            <TableColumn fx:id="careerCol" text="Carrera" prefWidth="200"/>
            <TableColumn fx:id="semesterCol" text="Sem." prefWidth="55"/>
            <TableColumn fx:id="studentsCol" text="Alumnos" prefWidth="75"/>
            <TableColumn fx:id="hoursCol" text="En horario" prefWidth="95"/>
            <TableColumn fx:id="gradedCol" text="Calificaciones finales" prefWidth="160"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label fx:id="countLabel" styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="gradesButton" text="Capturar calificaciones" onAction="#onGrades" styleClass="accent"/>
    </HBox>
</VBox>
