<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.groups.GroupsController"
      styleClass="view" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Grupos" styleClass="view-title"/>
            <Label text="Grupos por carrera y semestre, con su tutor, sus materias (y quién las imparte) y sus alumnos."
                   styleClass="view-subtitle" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo grupo" onAction="#onNew" styleClass="accent"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Buscar por nombre" prefWidth="200"/>
        <Label text="Carrera:"/>
        <ComboBox fx:id="careerCombo" prefWidth="210"/>
        <Label text="Semestre:"/>
        <ComboBox fx:id="semesterCombo" prefWidth="100"/>
        <Label text="Estatus:"/>
        <ComboBox fx:id="statusCombo" prefWidth="120"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="view-subtitle"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameCol" text="Grupo" prefWidth="100"/>
            <TableColumn fx:id="careerCol" text="Carrera" prefWidth="200"/>
            <TableColumn fx:id="semesterCol" text="Sem." prefWidth="55"/>
            <TableColumn fx:id="tutorCol" text="Tutor" prefWidth="180"/>
            <TableColumn fx:id="studentsCol" text="Alumnos" prefWidth="75"/>
            <TableColumn fx:id="subjectsCol" text="Materias" prefWidth="75"/>
            <TableColumn fx:id="unassignedCol" text="Sin profesor" prefWidth="95"/>
            <TableColumn fx:id="statusCol" text="Estatus" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Doble clic en una fila para administrar sus materias y alumnos." styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="editButton" text="Editar datos" onAction="#onEdit"/>
        <Button fx:id="manageButton" text="Materias y alumnos…" onAction="#onManage"/>
    </HBox>
</VBox>
