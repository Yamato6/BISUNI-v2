<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.periods.PeriodsController"
      styleClass="view" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Periodos escolares" styleClass="view-title"/>
            <Label text="Ciclo de cada periodo: planeado → activo → cerrado. Solo hay un periodo activo; al cerrarlo, sus calificaciones quedan como historial. La convocatoria abierta permite registrarse a los aspirantes en el portal."
                   styleClass="view-subtitle" wrapText="true"/>
        </VBox>
        <Button minWidth="-Infinity" text="Nuevo periodo" onAction="#onNew" styleClass="accent"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="activeLabel" styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="view-subtitle"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameCol" text="Periodo" prefWidth="110"/>
            <TableColumn fx:id="startCol" text="Inicio" prefWidth="120"/>
            <TableColumn fx:id="endCol" text="Fin" prefWidth="120"/>
            <TableColumn fx:id="statusCol" text="Estatus" prefWidth="100"/>
            <TableColumn fx:id="admissionsCol" text="Convocatoria" prefWidth="110"/>
            <TableColumn fx:id="groupsCol" text="Grupos" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Para cerrar un periodo, los profesores deben cerrar todas sus actas." styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="editButton" text="Editar" onAction="#onEdit"/>
        <Button minWidth="-Infinity" fx:id="admissionsButton" text="Abrir convocatoria" onAction="#onToggleAdmissions"/>
        <Button minWidth="-Infinity" fx:id="activateButton" text="Activar…" onAction="#onActivate"/>
        <Button minWidth="-Infinity" fx:id="closeButton" text="Cerrar periodo…" onAction="#onClose"/>
    </HBox>
</VBox>
