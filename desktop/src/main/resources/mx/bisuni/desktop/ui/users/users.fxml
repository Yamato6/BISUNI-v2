<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.users.UsersController"
      styleClass="view" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Usuarios" styleClass="view-title"/>
            <Label text="Cuentas de acceso de todo el personal y los alumnos. Los aspirantes se registran desde el portal web."
                   styleClass="view-subtitle" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="newButton" text="Nuevo usuario" onAction="#onNew" styleClass="accent"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Buscar por nombre, usuario o correo" prefWidth="320"/>
        <Label text="Rol:"/>
        <ComboBox fx:id="roleCombo" prefWidth="150"/>
        <Label text="Estatus:"/>
        <ComboBox fx:id="statusCombo" prefWidth="130"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="view-subtitle"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameCol" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="usernameCol" text="Usuario" prefWidth="130"/>
            <TableColumn fx:id="emailCol" text="Correo" prefWidth="240"/>
            <TableColumn fx:id="roleCol" text="Rol" prefWidth="120"/>
            <TableColumn fx:id="statusCol" text="Estatus" prefWidth="100"/>
            <TableColumn fx:id="createdCol" text="Alta" prefWidth="110"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Doble clic en una fila para editarla." styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="editButton" text="Editar" onAction="#onEdit"/>
    </HBox>
</VBox>
