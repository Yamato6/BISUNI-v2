<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.teacher.GradesController"
      styleClass="view" spacing="14">
    <VBox spacing="2">
        <Label text="Calificaciones" styleClass="view-title"/>
        <Label text="Escribe los parciales (0 a 10, hasta 2 decimales) y guarda. La calificación final es el promedio de los tres y la calcula el sistema."
               styleClass="view-subtitle" wrapText="true"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Clase:"/>
        <ComboBox fx:id="classCombo" prefWidth="380"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="progressLabel" styleClass="view-subtitle"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameCol" text="Alumno" prefWidth="260"/>
            <TableColumn fx:id="usernameCol" text="Usuario" prefWidth="120"/>
            <TableColumn fx:id="p1Col" text="Parcial 1" prefWidth="95" sortable="false"/>
            <TableColumn fx:id="p2Col" text="Parcial 2" prefWidth="95" sortable="false"/>
            <TableColumn fx:id="p3Col" text="Parcial 3" prefWidth="95" sortable="false"/>
            <TableColumn fx:id="finalCol" text="Final" prefWidth="80" sortable="false"/>
            <TableColumn fx:id="noteCol" text="" prefWidth="160" sortable="false"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="changesLabel" styleClass="changes-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="discardButton" text="Descartar cambios" onAction="#onDiscard"/>
        <Button fx:id="saveButton" text="Guardar calificaciones" onAction="#onSave" styleClass="accent"/>
    </HBox>
</VBox>
