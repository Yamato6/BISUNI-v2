<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.careers.CareersController"
      styleClass="view" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Carreras" styleClass="view-title"/>
            <Label text="Carreras que ofrece la universidad. La clave forma la matrícula de los alumnos (2026IT0001) y el número de semestres marca cuándo egresa un grupo."
                   styleClass="view-subtitle" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" text="Nueva carrera" onAction="#onNew" styleClass="accent"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Estatus:" minWidth="-Infinity"/>
        <ComboBox fx:id="statusCombo" prefWidth="120"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="view-subtitle"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameCol" text="Carrera" prefWidth="260"/>
            <TableColumn fx:id="codeCol" text="Clave" prefWidth="70"/>
            <TableColumn fx:id="semestersCol" text="Semestres" prefWidth="85"/>
            <TableColumn fx:id="subjectsCol" text="Materias" prefWidth="80"/>
            <TableColumn fx:id="studentsCol" text="Alumnos" prefWidth="80"/>
            <TableColumn fx:id="statusCol" text="Estatus" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Doble clic en una fila para editarla. Una carrera inactiva ya no aparece en el registro de aspirantes." styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="editButton" text="Editar" onAction="#onEdit"/>
    </HBox>
</VBox>
