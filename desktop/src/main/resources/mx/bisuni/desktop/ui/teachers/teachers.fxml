<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.teachers.TeachersController"
      styleClass="view" spacing="14">
    <VBox spacing="2">
        <Label text="Profesores" styleClass="view-title"/>
        <Label text="Perfil de cada profesor y las materias que está habilitado para impartir. Para dar de alta un profesor usa Usuarios."
               styleClass="view-subtitle" wrapText="true"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Buscar por nombre, usuario, correo o especialidad" prefWidth="340"/>
        <Label text="Estatus:"/>
        <ComboBox fx:id="statusCombo" prefWidth="130"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="view-subtitle"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameCol" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="usernameCol" text="Usuario" prefWidth="110"/>
            <TableColumn fx:id="emailCol" text="Correo" prefWidth="220"/>
            <TableColumn fx:id="specialtyCol" text="Especialidad" prefWidth="180"/>
            <TableColumn fx:id="phoneCol" text="Teléfono" prefWidth="130"/>
            <TableColumn fx:id="subjectsCol" text="Materias" prefWidth="75"/>
            <TableColumn fx:id="statusCol" text="Estatus" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Doble clic en una fila para editar el perfil." styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="subjectsButton" text="Materias…" onAction="#onSubjects"/>
        <Button fx:id="editButton" text="Editar perfil" onAction="#onEdit"/>
    </HBox>
</VBox>
