<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.teacher.AttendanceController"
      styleClass="view" spacing="14">
    <VBox spacing="2">
        <Label text="Asistencia" styleClass="view-title"/>
        <Label text="Pasa lista de una clase: marca a cada alumno y guarda. Puedes corregir días anteriores. Se marca en rojo a quien supera el 20 % de faltas en la materia."
               styleClass="view-subtitle" wrapText="true"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Clase:" minWidth="-Infinity"/>
        <ComboBox fx:id="classCombo" prefWidth="360"/>
        <Label text="Fecha:" minWidth="-Infinity"/>
        <DatePicker fx:id="datePicker" prefWidth="150"/>
        <Label fx:id="dayWarning" styleClass="attendance-warning" wrapText="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="allPresentButton" text="Todos presentes" onAction="#onAllPresent"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameCol" text="Alumno" prefWidth="250"/>
            <TableColumn fx:id="enrollmentCol" text="Matrícula" prefWidth="110"/>
            <TableColumn fx:id="statusCol" text="Asistencia" prefWidth="390" sortable="false"/>
            <TableColumn fx:id="absencesCol" text="Faltas en la materia" prefWidth="170"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="summaryLabel" styleClass="changes-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="discardButton" text="Descartar cambios" onAction="#onDiscard"/>
        <Button minWidth="-Infinity" fx:id="saveButton" text="Guardar asistencia" onAction="#onSave" styleClass="accent"/>
    </HBox>
</VBox>
