<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.subjects.SubjectsController"
      styleClass="view" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label text="Materias" styleClass="view-title"/>
            <Label text="Catálogo de materias por carrera y semestre."
                   styleClass="view-subtitle" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" text="Nueva materia" onAction="#onNew" styleClass="accent"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Buscar por nombre" prefWidth="240"/>
        <Label text="Carrera:" minWidth="-Infinity"/>
        <ComboBox fx:id="careerCombo" prefWidth="210"/>
        <Label text="Semestre:" minWidth="-Infinity"/>
        <ComboBox fx:id="semesterCombo" prefWidth="100"/>
        <Label text="Estatus:" minWidth="-Infinity"/>
        <ComboBox fx:id="statusCombo" prefWidth="120"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="view-subtitle"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameCol" text="Materia" prefWidth="240"/>
            <TableColumn fx:id="careerCol" text="Carrera" prefWidth="200"/>
            <TableColumn fx:id="semesterCol" text="Sem." prefWidth="55"/>
            <TableColumn fx:id="creditsCol" text="Créditos" prefWidth="70"/>
            <TableColumn fx:id="hoursCol" text="Horas/sem." prefWidth="85"/>
            <TableColumn fx:id="groupsCol" text="Grupos" prefWidth="65"/>
            <TableColumn fx:id="teachersCol" text="Profesores" prefWidth="80"/>
            <TableColumn fx:id="statusCol" text="Estatus" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Doble clic en una fila para editarla. Los profesores habilitados se asignan en Profesores → Materias." styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="editButton" text="Editar" onAction="#onEdit"/>
    </HBox>
</VBox>
