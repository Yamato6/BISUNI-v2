<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="mx.bisuni.desktop.ui.students.StudentsController"
      styleClass="view" spacing="14">
    <VBox spacing="2">
        <Label text="Alumnos" styleClass="view-title"/>
        <Label text="Perfil académico de cada alumno: matrícula, carrera, semestre, grupo, situación y promedio (calculado de sus calificaciones). Para dar de alta un alumno usa Admisiones o Usuarios."
               styleClass="view-subtitle" wrapText="true"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Buscar por nombre, matrícula, usuario o correo" prefWidth="360"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="view-subtitle" minWidth="-Infinity"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Carrera:" minWidth="-Infinity"/>
        <ComboBox fx:id="careerCombo" prefWidth="190"/>
        <Label text="Grupo:" minWidth="-Infinity"/>
        <ComboBox fx:id="groupCombo" prefWidth="150"/>
        <Label text="Situación:" minWidth="-Infinity"/>
        <ComboBox fx:id="academicCombo" prefWidth="140"/>
        <Label text="Cuenta:" minWidth="-Infinity"/>
        <ComboBox fx:id="statusCombo" prefWidth="110"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label fx:id="placeholderLabel" text="Cargando…"/></placeholder>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="enrollmentCol" text="Matrícula" prefWidth="110" minWidth="105"/>
            <TableColumn fx:id="nameCol" text="Nombre" prefWidth="190"/>
            <TableColumn fx:id="emailCol" text="Correo" prefWidth="200"/>
            <TableColumn fx:id="careerCol" text="Carrera" prefWidth="170"/>
            <TableColumn fx:id="semesterCol" text="Sem." prefWidth="55" minWidth="50"/>
            <TableColumn fx:id="groupCol" text="Grupo" prefWidth="90"/>
            <TableColumn fx:id="gpaCol" text="Promedio" prefWidth="75"/>
            <TableColumn fx:id="academicCol" text="Situación" prefWidth="105"/>
            <TableColumn fx:id="statusCol" text="Cuenta" prefWidth="70"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Doble clic en una fila para editarla." styleClass="view-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="-Infinity" fx:id="situationButton" text="Cambiar situación…" onAction="#onSituation"/>
        <Button minWidth="-Infinity" fx:id="editButton" text="Editar" onAction="#onEdit"/>
    </HBox>
</VBox>
